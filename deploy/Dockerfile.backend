# 濮院毛衫 AI 平台 - 后端运行时 Dockerfile
# 策略: 仅构建一次基础镜像，后续更新通过 volume 挂载 jar 实现
# 使用: docker build -t puyuan-ai-platform-backend:latest .
# 然后 docker-compose.yml 用 image: + volume mount jar
FROM eclipse-temurin:21-jdk-alpine

LABEL maintainer="puyuan-maoshan <contact@puyuanmaoshan.com>"

RUN apk add --no-cache curl

RUN addgroup -S appuser && adduser -S -G appuser appuser

WORKDIR /app

# 占位 jar — 实际 jar 通过 volume mount 范围覆盖
COPY placeholder.jar ./app.jar

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

ENV JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"