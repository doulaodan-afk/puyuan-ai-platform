# 濮院毛衫 AI 平台 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# =====================================
# MySQL 数据库配置
# =====================================
MYSQL_ROOT_PASSWORD=your_strong_password_here
MYSQL_DATABASE=puyuan_ai_prod
MYSQL_USER=puyuan_user
MYSQL_PASSWORD=your_strong_password_here

# =====================================
# Redis 缓存配置
# =====================================
REDIS_PASSWORD=your_redis_password_here

# =====================================
# 内容安全配置
# =====================================
# true: 启用内容安全检查，false: 禁用
CONTENT_SECURITY_ENABLED=true

# =====================================
# 微信小程序配置
# =====================================
# 从微信公众平台获取
WX_MINIAPP_APPID=your_appid_here
WX_MINIAPP_SECRET=your_secret_here

# =====================================
# AI 服务配置
# =====================================
# true: 使用 Mock 模式（开发环境），false: 使用真实 API（生产环境）
AI_MOCK_ENABLED=false

# OpenAI API Key（生产环境需要）
OPENAI_API_KEY=sk-your-openai-api-key-here

# =====================================
# Nginx SSL 证书
# =====================================
# SSL 证书通过 certbot 自动生成和续期
# 证书文件将保存在 nginx/ssl/ 目录
#
# 手动配置（如使用自己的证书）：
# 1. 将 fullchain.pem 放到 nginx/ssl/ 目录
# 2. 将 privkey.pem 放到 nginx/ssl/ 目录
# 3. 重启 Nginx: docker-compose restart nginx
